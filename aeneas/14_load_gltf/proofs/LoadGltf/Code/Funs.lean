def validate.mesh.attribute_type_ok
  (kind : Std.U64) (a : model.Accessor) (morph : Bool) : Result Bool := do
  if kind = validate.mesh.SEM_OTHER
  then ok true
  else
    if a.is_matrix
    then ok false
    else
      if kind = validate.mesh.SEM_POSITION
      then if a.components = 3#u64
           then validate.util.float32 a
           else ok false
      else
        if kind = validate.mesh.SEM_NORMAL
        then if a.components = 3#u64
             then validate.util.float32 a
             else ok false
        else
          if kind = validate.mesh.SEM_TANGENT
          then
            let i ← if morph
                      then ok 3#u64
                      else ok 4#u64
            if a.components = i
            then validate.util.float32 a
            else ok false
          else
            if kind = validate.mesh.SEM_TEXCOORD
            then
              if a.components = 2#u64
              then
                let b ← validate.util.float32 a
                if b
                then ok true
                else
                  let b1 ← validate.util.unorm8_16 a
                  if b1
                  then ok true
                  else if morph
                       then validate.util.snorm8_16 a
                       else ok false
              else ok false
            else
              if kind = validate.mesh.SEM_COLOR
              then
                if a.components = 3#u64
                then
                  let b ← validate.util.float32 a
                  if b
                  then ok true
                  else
                    let b1 ← validate.util.unorm8_16 a
                    if b1
                    then ok true
                    else if morph
                         then validate.util.snorm8_16 a
                         else ok false
                else
                  if a.components = 4#u64
                  then
                    let b ← validate.util.float32 a
                    if b
                    then ok true
                    else
                      let b1 ← validate.util.unorm8_16 a
                      if b1
                      then ok true
                      else
                        if morph
                        then validate.util.snorm8_16 a
                        else ok false
                  else ok false
              else
                if kind = validate.mesh.SEM_JOINTS
                then
                  if morph
                  then ok false
                  else
                    if a.components = 4#u64
                    then
                      if a.normalized
                      then ok false
                      else
                        if a.component_type = 5121#u64
                        then ok true
                        else ok (a.component_type = 5123#u64)
                    else ok false
                else
                  if kind = validate.mesh.SEM_WEIGHTS
                  then
                    if morph
                    then ok false
                    else
                      if a.components = 4#u64
                      then
                        let b ← validate.util.float32 a
                        if b
                        then ok true
                        else validate.util.unorm8_16 a
